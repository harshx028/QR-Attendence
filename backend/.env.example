# Server
PORT=3000
NODE_ENV=development

# Database (Prisma supports both SQLite and PostgreSQL adapters)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/qr_db?schema=public"

# Authentication - REQUIRED in production
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated list of allowed CORS origins for web clients.
# Leave unset to disable cross-origin browser requests.
# CORS_ORIGIN="https://app.example.com"

# Optional: password for the /admin HTML report page.
# When unset, the /admin page is disabled (404).
# ADMIN_PANEL_PASSWORD="change-me"
